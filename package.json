{
  "name": "create-tsx-app",
  "version": "5.1.0",
  "description": "Scaffold a production-ready TypeScript project with tsx, in seconds.",
  "keywords": [
    "boilerplate",
    "cli",
    "express",
    "fastify",
    "scaffold",
    "tsx",
    "typescript"
  ],
  "homepage": "https://github.com/mattiamalonni/create-tsx-app#readme",
  "bugs": {
    "url": "https://github.com/mattiamalonni/create-tsx-app/issues"
  },
  "license": "MIT",
  "author": "Mattia Malonni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattiamalonni/create-tsx-app.git"
  },
  "bin": {
    "create-tsx-app": "index.js"
  },
  "files": [
    "dist",
    "templates",
    "index.js",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "unbuild --stub && node dist/index.mjs",
    "build": "unbuild",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/node": "^22.20.7",
    "cac": "^7.1.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
